    "astro": "^7.3.5",
    "satori": "^0.33.5"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3"
  },
  "private": true,
  "description": "Portfolio site of Emmanuel Paddy Adams, built with Astro."
