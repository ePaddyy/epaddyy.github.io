---
interface Props {
  items: { value: string; label: string; note?: string }[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<dl class:list={['stats', 'reveal', className]}>
  {items.map((s) => (
    <div class="stat">
      <dt>{s.label}</dt>
      <dd>
        {s.value}
        {s.note && <span class="stat-note">{s.note}</span>}
      </dd>
    </div>
  ))}
</dl>
