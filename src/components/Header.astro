---
import Icon from './Icon.astro';
import { nav, site } from '../config/site';
import { getPosts } from '../lib/content';

const hasPosts = (await getPosts()).length > 0;
const path = Astro.url.pathname;
const onHome = path === '/';

const links = nav
  .filter((item) => !('requiresPosts' in item) || hasPosts)
  .map((item) => {
    const isSection = item.href.startsWith('/#');
    return {
      ...item,
      section: isSection && onHome ? item.href.slice(2) : undefined,
      active: !isSection && path.startsWith(item.href),
    };
  });
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <span class="brand-mark">{site.shortName}</span>
      <span class="brand-name">{site.name}</span>
    </a>

    <nav class="site-nav" id="siteNav" aria-label="Main">
      <ul>
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              data-section={link.section}
              class:list={{ active: link.active }}
              aria-current={link.active ? 'page' : undefined}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="icon-btn" id="themeToggle" type="button" aria-label="Toggle dark mode">
        <Icon name="sun" class="icon-sun" />
        <Icon name="moon" class="icon-moon" />
      </button>
      <a href={site.cv} target="_blank" rel="noopener" class="btn btn-sm btn-primary header-cv">
        Résumé
      </a>
      <button
        class="icon-btn nav-toggle"
        id="navToggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="siteNav"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>
</header>
