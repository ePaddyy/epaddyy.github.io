---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatDate, getPosts, projectUrl } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const related = post.data.relatedProject ? await getEntry(post.data.relatedProject) : undefined;
---

<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <article class="case-study">
    <header class="page-hero">
      <div class="container case-narrow">
        <a href="/writing/" class="back-link">
          ← All writing
        </a>
        <p class="section-kicker">
          <time datetime={post.data.publishedAt.toISOString()}>
            {formatDate(post.data.publishedAt)}
          </time>
          {post.data.draft && ' · Draft'}
        </p>
        <h1>{post.data.title}</h1>
        <p class="page-lead">{post.data.description}</p>
      </div>
    </header>
    <div class="container case-narrow">
      <div class="case-body prose markdown">
        <Content />
      </div>
      <div class="case-footer">
        {related ? (
          <a href={related.data.caseStudy ? projectUrl(related) : '/projects/'} class="text-link">
            Related project: {related.data.title} →
          </a>
        ) : (
          <a href="/writing/" class="text-link">
            ← All writing
          </a>
        )}
        <a href="/#contact" class="btn btn-secondary">
          Get in touch
        </a>
      </div>
    </div>
  </article>
</BaseLayout>
