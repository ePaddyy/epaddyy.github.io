---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import Stats from '../components/Stats.astro';
import ProjectCard from '../components/ProjectCard.astro';
import TimelineItem from '../components/TimelineItem.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../config/site';
import {
  formatDateRange,
  getCertifications,
  getEducation,
  getExperience,
  getHomeProjects,
  getProjects,
  projectUrl,
} from '../lib/content';

const projects = await getProjects();
const homeProjects = await getHomeProjects();
const experience = await Promise.all(
  (await getExperience()).map(async (e) => ({ entry: e, Content: (await render(e)).Content })),
);
const education = await getEducation();
const certifications = await getCertifications();

// Home-page text lives in src/content/home/*.md
const section = async (id: string) => {
  const entry = await getEntry('home', id);
  if (!entry) throw new Error(`Missing src/content/home/${id}.md`);
  return { data: entry.data, Content: (await render(entry)).Content };
};
const hero = await section('hero');
const about = await section('about');
const skills = await section('skills');
const contact = await section('contact');

const flagship = projects.find((p) => p.data.featured && p.data.caseStudy);
const building = projects.find((p) => p.data.status === 'in-progress');

// Headline numbers come straight from the project files: change a metric there, it changes here.
const metricStats = projects
  .filter((p) => p.data.category === 'ml' && p.data.status === 'complete' && p.data.metric)
  .slice(0, 2)
  .map((p) => ({
    value: p.data.metric!.value,
    label: `${p.data.metric!.name} · ${p.data.title}`,
  }));
const stats = [
  ...metricStats,
  { value: String(projects.length), label: 'Projects published' },
  { value: String(certifications.length), label: 'Data certifications' },
];
---

<BaseLayout>
  <!-- HERO -->
  <section id="hero" class="hero">
    <div class="container hero-grid">
      <div class="hero-copy reveal">
        <p class="eyebrow">
          <span class="status-dot" aria-hidden="true"></span> {site.availability}
        </p>
        <h1>{site.name}</h1>
        <p class="hero-role">{site.role}</p>
        <div class="hero-lead">
          <hero.Content />
        </div>
        <div class="hero-cta">
          {flagship && (
            <a href={projectUrl(flagship)} class="btn btn-primary">
              Read the featured case study
            </a>
          )}
          <a href="/projects/" class="btn btn-secondary">
            All projects
          </a>
        </div>
        <ul class="hero-meta">
          <li>
            <Icon name="map-pin" size={15} /> {site.location}
          </li>
          {building && (
            <li>
              <Icon name="clock" size={15} /> Currently building: {building.data.title}
            </li>
          )}
          <li>
            <Icon name="download" size={15} />
            <a href={site.cv} target="_blank" rel="noopener">
              Download CV (PDF)
            </a>
          </li>
        </ul>
      </div>
      <div class="hero-photo reveal">
        <Photo />
      </div>
    </div>
    <div class="container">
      <Stats items={stats} />
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about" class="section">
    <div class="container split">
      <div class="section-head reveal">
        <p class="section-kicker">About</p>
        <h2>{about.data.heading}</h2>
      </div>
      <div class="prose reveal">
        <about.Content />
        {about.data.focus && (
          <ul class="focus-list">
            {about.data.focus.map((item) => (
              <li>
                <Icon name="check" size={16} /> {item}
              </li>
            ))}
          </ul>
        )}
        {about.data.outside && <p class="aside">{about.data.outside}</p>}
      </div>
    </div>
  </section>

  <!-- SELECTED WORK -->
  <section id="work" class="section section-alt">
    <div class="container">
      <div class="section-head section-head-row reveal">
        <div>
          <p class="section-kicker">Selected work</p>
          <h2>Featured projects</h2>
        </div>
        <a href="/projects/" class="text-link">
          All projects →
        </a>
      </div>
      <div class="project-grid">
        {homeProjects.map((p, i) => (
          <ProjectCard project={p} wide={i === 0} />
        ))}
      </div>
    </div>
  </section>

  <!-- EXPERIENCE -->
  <section id="experience" class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="section-kicker">Experience</p>
        <h2>Experience &amp; education</h2>
      </div>
      <div class="experience-grid">
        <div class="reveal">
          <h3 class="col-title">Work</h3>
          <ol class="timeline">
            {experience.map(({ entry, Content }) => (
              <TimelineItem
                title={entry.data.role}
                subtitle={`${entry.data.org} · ${entry.data.location}`}
                dates={formatDateRange(entry.data.start, entry.data.end)}
                link={entry.data.link}
              >
                <Content />
              </TimelineItem>
            ))}
          </ol>
        </div>
        <div class="reveal">
          <h3 class="col-title">Education</h3>
          <ol class="timeline">
            {education.map((e) => (
              <TimelineItem
                title={e.data.degree}
                subtitle={e.data.org}
                dates={e.data.year}
                detail={e.data.courses.join(', ')}
              />
            ))}
          </ol>
          <h3 class="col-title">Training &amp; certifications</h3>
          <ul class="cert-list">
            {certifications.map((c) => (
              <li>
                <span>
                  <strong>{c.data.org}</strong> · {c.data.title}
                </span>
                <span class="muted">{c.data.year}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- SKILLS -->
  <section id="skills" class="section section-alt">
    <div class="container">
      <div class="section-head reveal">
        <p class="section-kicker">Skills</p>
        <h2>{skills.data.heading}</h2>
      </div>
      <div class="capabilities">
        {skills.data.capabilities?.map((c) => (
          <div class="capability reveal">
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <ul class="tag-list">
              {c.tags.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      {skills.data.toolkit && (
        <div class="toolkit reveal">
          <h3>Toolkit</h3>
          <div class="toolkit-groups">
            {skills.data.toolkit.map((g) => (
              <div>
                <h4>{g.group}</h4>
                <p>{g.items}</p>
              </div>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact" class="section">
    <div class="container split">
      <div class="reveal">
        <p class="section-kicker">Contact</p>
        <h2>{contact.data.heading}</h2>
        <div class="contact-lead">
          <contact.Content />
        </div>
        <ul class="contact-links">
          <li>
            <a href={`mailto:${site.email}`}>
              <span>Email</span>
              <span class="muted">{site.email}</span>
            </a>
          </li>
          {site.socials.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener">
                <span>{s.label}</span>
                <span class="muted">{s.handle}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <ContactForm />
    </div>
  </section>
</BaseLayout>
